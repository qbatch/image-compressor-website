---
const { size = 32 } = Astro.props;
---
<a href="/" class="logo" aria-label="TrueSize home">
  <svg width={size} height={size} viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#4f46e5"/><path d="M20 26l8 6-8 6M44 26l-8 6 8 6" fill="none" stroke="#fff" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="32" cy="32" r="3.5" fill="#c7d2fe"/></svg>
  <span>TrueSize</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 18px; letter-spacing: -0.02em; color: var(--text); text-decoration: none; min-height: 44px; }
  .logo:hover { color: var(--text); }
</style>
