---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="nf container"><span class="eyebrow">404</span><h1>That page doesn’t exist.</h1><p>The link may be broken or the page may have moved.</p><a class="btn btn-primary" href="/">Back to home</a></section>
</Base>
<style>
  .nf { text-align: center; padding-block: 120px; display: grid; justify-items: center; gap: 16px; }
  h1 { font-size: clamp(32px, 5vw, 48px); } p { color: var(--muted); margin-bottom: 8px; }
</style>
